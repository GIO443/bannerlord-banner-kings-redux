# Copy to .env and fill in
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_FAQ_REVIEW_CHANNEL_ID=

# Primary LLM (free tier: ~30 req/min, no card)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback LLM (free tier: 1500 req/day)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Paths
WIKI_PATH=../docs/WIKI.md
CHROMA_DIR=./chroma_db
SQLITE_PATH=./bk_bot.sqlite

# Tuning
FAQ_HIT_THRESHOLD=0.85
RAG_TOP_K=5
CHUNK_TOKENS=500
CHUNK_OVERLAP=50
CLUSTER_MIN_SIZE=3
CLUSTER_EPS=0.25
FAQ_PRUNE_DAYS=90
LOG_RETENTION_DAYS=180
