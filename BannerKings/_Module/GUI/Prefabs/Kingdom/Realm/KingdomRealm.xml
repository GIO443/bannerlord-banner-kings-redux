<Prefab>
	<Window>
		<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@RealmSelected" IsActive="true">
			<Children>

				<ScrollablePanel Id="RealmScrollablePanel" WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
				                 MarginLeft="3" MarginBottom="3" AutoHideScrollBars="true" ClipRect="Rect"
				                 InnerPanel="Rect\VerticalList" MouseScrollAxis="Vertical"
				                 VerticalScrollbar="..\RealmScrollbar\Scrollbar">
					<Children>

						<Widget Id="Rect" WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" ClipContents="true">
							<Children>

								<ListPanel Id="VerticalList" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="Vertical">
									<Children>

										<Standard.DropdownWithHorizontalControl Parameter.SelectorDataSource="{KingdomSelector}" MarginTop="10"
																				HorizontalAlignment="Center" />

										<!-- The Crown -->
										<RichTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginTop="25"
														HorizontalAlignment="Center" Brush="Clan.Leader.Text" Brush.FontSize="32" Text="@GovernmentSectionText"
														MarginBottom="15" />

										<ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center"
												   VerticalAlignment="Center" StackLayout.LayoutMethod="Vertical" MarginBottom="10">
											<Children>
												<ToggleButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
														SuggestedWidth="340" SuggestedHeight="90" HorizontalAlignment="Center" Brush="TownManagement.Governor"
														UpdateChildrenStates="true" GamepadNavigationIndex="0" IsEnabled="true" Command.Click="ChangeGovernment">
													<Children>
														<RichTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
																HorizontalAlignment="Center" VerticalAlignment="Center" Brush="Clan.Leader.Text" Brush.FontSize="30"
																Text="@GovernmentName" MarginLeft="15" MarginRight="15" />
														<HintWidget DataSource="{GovernmentHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
																	Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
													</Children>
												</ToggleButtonWidget>
												<RichTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginTop="6"
														HorizontalAlignment="Center" Brush="ArmyManagement.Army.Tuple.Name" Brush.FontSize="20" Text="@GovernmentLayerText" />
											</Children>
										</ListPanel>

										<!-- Politics dashboard: Crown Authority / Legitimacy / War Fatigue / Transition.
										     Each is a BKFillBar kit component bound to a BKFillBarVM on the VM. -->
										<ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center"
												   VerticalAlignment="Center" StackLayout.LayoutMethod="Vertical" MarginTop="15" MarginBottom="10"
												   IsVisible="@HasDiplomacy">
											<Children>

												<BKFillBar DataSource="{CrownAuthorityBar}" HorizontalAlignment="Center" MarginTop="6" MarginBottom="6" />

												<BKFillBar DataSource="{LegitimacyBar}" HorizontalAlignment="Center" MarginTop="6" MarginBottom="6" />

												<BKFillBar DataSource="{FatigueBar}" HorizontalAlignment="Center" MarginTop="6" MarginBottom="6" />

												<BKFillBar DataSource="{TransitionBar}" HorizontalAlignment="Center" MarginTop="6" MarginBottom="6" />

											</Children>
										</ListPanel>

										<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="7"
												MarginLeft="500" MarginRight="500" MarginTop="20" MarginBottom="20" VerticalAlignment="Center"
												Sprite="SPGeneral\TownManagement\horizontal_divider" />

										<!-- Succession -->
										<RichTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginTop="10"
														HorizontalAlignment="Center" Brush="Clan.Leader.Text" Brush.FontSize="32" Text="@SuccessionText"
														MarginBottom="15" />

										<ToggleButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
												SuggestedWidth="340" SuggestedHeight="80" HorizontalAlignment="Center" Brush="TownManagement.Governor"
												UpdateChildrenStates="true" GamepadNavigationIndex="0" IsEnabled="true" Command.Click="ChangeSuccession">
											<Children>
												<RichTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
														HorizontalAlignment="Center" VerticalAlignment="Center" Brush="Clan.Leader.Text" Brush.FontSize="28"
														Text="@SuccessionName" MarginLeft="15" MarginRight="15" />
												<HintWidget DataSource="{SuccessionHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
															Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
											</Children>
										</ToggleButtonWidget>

										<RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="15"
														HorizontalAlignment="Center" Brush="Clan.Leader.Text" Brush.FontSize="22" Text="@SuccessionDescription"
														MarginBottom="15" MarginRight="500" MarginLeft="500" />

										<ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" HorizontalAlignment="Center" SuggestedHeight="150"
												   VerticalAlignment="Center" StackLayout.LayoutMethod="HorizontalLeftToRight" MarginTop="20" MarginBottom="30" DoNotAcceptEvents="false">
											<Children>

												<ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" SuggestedHeight="150"
														   VerticalAlignment="Bottom" StackLayout.LayoutMethod="Vertical" MarginBottom="29" DoNotAcceptEvents="false">
													<Children>
														<RichTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
																		HorizontalAlignment="Center" Brush="Clan.Leader.Text" Brush.FontSize="22" Text="@HeirText"
																		MarginBottom="5" VerticalAlignment="Top" />
														<ToggleButtonWidget DataSource="{MainHeir}" DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
																VerticalAlignment="Bottom" SuggestedWidth="171" SuggestedHeight="100" MarginRight="2" MarginLeft="2"
																HorizontalAlignment="Center" Brush="TownManagement.Governor" UpdateChildrenStates="true"
																GamepadNavigationIndex="0" IsEnabled="true">
															<Children>
																<ImageIdentifierWidget Id="ElementImage" DataSource="{ImageIdentifier}" WidthSizePolicy="StretchToParent"
																					   HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" MarginLeft="3"
																					   MarginRight="3" MarginTop="3" MarginBottom="3" AdditionalArgs="@AdditionalArgs"
																					   ImageId="@Id" TextureProviderName="@TextureProviderName" />
																<HintWidget DataSource="{Hint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
																			Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
															</Children>
														</ToggleButtonWidget>
													</Children>
												</ListPanel>

												<GridWidget Id="CoreGrid" DataSource="{Heirs}" WidthSizePolicy="CoverChildren"
															HeightSizePolicy="StretchToParent" VerticalAlignment="Bottom" HorizontalAlignment="Center"
															SuggestedHeight="350" DefaultCellWidth="160" DefaultCellHeight="110" ColumnCount="5">
													<ItemTemplate>
														<ToggleButtonWidget Id="GovernorSelectionButton" Command.Click="SetId" DoNotPassEventsToChildren="true"
																			WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="151" SuggestedHeight="100" MarginRight="2" MarginLeft="2"
																			HorizontalAlignment="Center" Brush="TownManagement.Governor" UpdateChildrenStates="true"
																			GamepadNavigationIndex="0" IsEnabled="true">
															<Children>
																<ImageIdentifierWidget Id="ElementImage" DataSource="{ImageIdentifier}" WidthSizePolicy="StretchToParent"
																					   HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" MarginLeft="3"
																					   MarginRight="3" MarginTop="3" MarginBottom="3" AdditionalArgs="@AdditionalArgs"
																					   ImageId="@Id" TextureProviderName="@TextureProviderName" />
																<HintWidget DataSource="{Hint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
																			Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
															</Children>
														</ToggleButtonWidget>
													</ItemTemplate>
												</GridWidget>

											</Children>
										</ListPanel>

									</Children>
								</ListPanel>

							</Children>
						</Widget>
					</Children>
				</ScrollablePanel>

				<Standard.VerticalScrollbar Id="RealmScrollbar" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right"
											VerticalAlignment="Bottom" MarginLeft="2" MarginRight="2" MarginBottom="3" />

			</Children>
		</Widget>
	</Window>
</Prefab>
