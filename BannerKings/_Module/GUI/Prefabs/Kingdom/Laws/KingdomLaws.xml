<Prefab>
	<Window>
		<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="@LawsSelected" IsActive="true">
			<Children>

				<ScrollablePanel Id="LawsScrollablePanel" WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
				                 MarginLeft="3" MarginBottom="3" AutoHideScrollBars="true" ClipRect="Rect"
				                 InnerPanel="Rect\VerticalList" MouseScrollAxis="Vertical"
				                 VerticalScrollbar="..\LawsScrollbar\Scrollbar">
					<Children>

						<Widget Id="Rect" WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent" ClipContents="true">
							<Children>

								<ListPanel Id="VerticalList" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" StackLayout.LayoutMethod="VerticalBottomToTop">
									<Children>

										<Standard.DropdownWithHorizontalControl Parameter.SelectorDataSource="{KingdomSelector}" MarginTop="10"
																				HorizontalAlignment="Center" />

										<!-- Contract aspects: Inheritance / Gender Law / Tax / Conquest -->
										<RichTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginTop="25"
														HorizontalAlignment="Center" Brush="Clan.Leader.Text" Brush.FontSize="32" Text="@StructureText"
														MarginBottom="20" />

										<ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" HorizontalAlignment="Center" SuggestedHeight="170"
												   VerticalAlignment="Center" StackLayout.LayoutMethod="HorizontalLeftToRight" MarginBottom="20" DoNotAcceptEvents="false">
											<Children>

												<ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" SuggestedHeight="150"
														   VerticalAlignment="Bottom" StackLayout.LayoutMethod="VerticalBottomToTop" MarginRight="15" MarginLeft="15">
													<Children>
														<RichTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
																HorizontalAlignment="Center" Brush="Clan.Leader.Text" Brush.FontSize="22" Text="@InheritanceText"
																MarginBottom="5" VerticalAlignment="Top" />
														<ToggleButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
																VerticalAlignment="Bottom" SuggestedWidth="280" SuggestedHeight="90" MarginRight="2" MarginLeft="2"
																HorizontalAlignment="Center" Brush="TownManagement.Governor" UpdateChildrenStates="true"
																GamepadNavigationIndex="0" IsEnabled="true" Command.Click="ChangeInheritance">
															<Children>
																<RichTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
																		HorizontalAlignment="Center" Brush="Clan.Leader.Text" Brush.FontSize="28" Text="@InheritanceName"
																		VerticalAlignment="Center" MarginRight="15" MarginLeft="15" />
																<HintWidget DataSource="{InheritanceHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
																			Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
															</Children>
														</ToggleButtonWidget>
													</Children>
												</ListPanel>

												<ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" SuggestedHeight="150"
														   VerticalAlignment="Bottom" StackLayout.LayoutMethod="VerticalBottomToTop" MarginRight="15" MarginLeft="15">
													<Children>
														<RichTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
																HorizontalAlignment="Center" Brush="Clan.Leader.Text" Brush.FontSize="22" Text="@GenderLawText"
																MarginBottom="5" VerticalAlignment="Top" />
														<ToggleButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
																VerticalAlignment="Bottom" SuggestedWidth="280" SuggestedHeight="90" MarginRight="2" MarginLeft="2"
																HorizontalAlignment="Center" Brush="TownManagement.Governor" UpdateChildrenStates="true"
																GamepadNavigationIndex="0" IsEnabled="true" Command.Click="ChangeGender">
															<Children>
																<RichTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
																		HorizontalAlignment="Center" Brush="Clan.Leader.Text" Brush.FontSize="28" Text="@GenderLawName"
																		VerticalAlignment="Center" MarginRight="15" MarginLeft="15" />
																<HintWidget DataSource="{GenderLawHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
																			Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
															</Children>
														</ToggleButtonWidget>
													</Children>
												</ListPanel>

												<ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" SuggestedHeight="150"
														   VerticalAlignment="Bottom" StackLayout.LayoutMethod="VerticalBottomToTop" MarginRight="15" MarginLeft="15">
													<Children>
														<RichTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
																HorizontalAlignment="Center" Brush="Clan.Leader.Text" Brush.FontSize="22" Text="@TaxText"
																MarginBottom="5" VerticalAlignment="Top" />
														<ToggleButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
																VerticalAlignment="Bottom" SuggestedWidth="280" SuggestedHeight="90" MarginRight="2" MarginLeft="2"
																HorizontalAlignment="Center" Brush="TownManagement.Governor" UpdateChildrenStates="true"
																GamepadNavigationIndex="0" IsEnabled="true" Command.Click="ChangeTax">
															<Children>
																<RichTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
																		HorizontalAlignment="Center" Brush="Clan.Leader.Text" Brush.FontSize="28" Text="@TaxName"
																		VerticalAlignment="Center" MarginRight="15" MarginLeft="15" />
																<HintWidget DataSource="{TaxHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
																			Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
															</Children>
														</ToggleButtonWidget>
													</Children>
												</ListPanel>

												<ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" SuggestedHeight="150"
														   VerticalAlignment="Bottom" StackLayout.LayoutMethod="VerticalBottomToTop" MarginRight="15" MarginLeft="15">
													<Children>
														<RichTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
																HorizontalAlignment="Center" Brush="Clan.Leader.Text" Brush.FontSize="22" Text="@ConquestText"
																MarginBottom="5" VerticalAlignment="Top" />
														<ToggleButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
																VerticalAlignment="Bottom" SuggestedWidth="280" SuggestedHeight="90" MarginRight="2" MarginLeft="2"
																HorizontalAlignment="Center" Brush="TownManagement.Governor" UpdateChildrenStates="true"
																GamepadNavigationIndex="0" IsEnabled="true" Command.Click="ChangeConquest">
															<Children>
																<RichTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
																		HorizontalAlignment="Center" Brush="Clan.Leader.Text" Brush.FontSize="28" Text="@ConquestName"
																		VerticalAlignment="Center" MarginRight="15" MarginLeft="15" />
																<HintWidget DataSource="{ConquestHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
																			Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
															</Children>
														</ToggleButtonWidget>
													</Children>
												</ListPanel>

											</Children>
										</ListPanel>

										<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="7"
												MarginLeft="500" MarginRight="500" MarginTop="20" MarginBottom="20" VerticalAlignment="Center"
												Sprite="SPGeneral\TownManagement\horizontal_divider" />

										<!-- Demesne Laws -->
										<RichTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MarginTop="10"
														HorizontalAlignment="Center" Brush="Clan.Leader.Text" Brush.FontSize="32" Text="@LawsText"
														MarginBottom="10" />

										<RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginTop="10"
														HorizontalAlignment="Center" Brush="Clan.Leader.Text" Brush.FontSize="22" Text="@LawsDescriptionText"
														MarginBottom="15" MarginRight="500" MarginLeft="500" />

										<GridWidget DataSource="{Laws}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
											SuggestedWidth="700" HorizontalAlignment="Center" DefaultCellWidth="700"
											DefaultCellHeight="400" ColumnCount="3" MarginTop="20" MarginBottom="30" MarginRight="150" MarginLeft="150">
											<ItemTemplate>
												<DemesneLawTuple />
											</ItemTemplate>
										</GridWidget>

									</Children>
								</ListPanel>

							</Children>
						</Widget>
					</Children>
				</ScrollablePanel>

				<Standard.VerticalScrollbar Id="LawsScrollbar" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right"
											VerticalAlignment="Bottom" MarginLeft="2" MarginRight="2" MarginBottom="3" />

			</Children>
		</Widget>
	</Window>
</Prefab>
