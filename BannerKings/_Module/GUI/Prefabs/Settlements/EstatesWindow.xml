<Prefab>
	<Constants>

		<Constant Name="CharacterDeveloper.SkillButtonBackground.Width" BrushLayer="Default"
		          BrushName="CharacterDeveloper.SkillButtonBackground" BrushValueType="Width" />
		<Constant Name="CharacterDeveloper.SkillButtonBackground.Height" BrushLayer="Default"
		          BrushName="CharacterDeveloper.SkillButtonBackground" BrushValueType="Height" />

	</Constants>
	<Window>
		<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#00000088">
			<Children>
				<CharacterDeveloperAttributeInspectionPopupWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
				                                                  SuggestedWidth="850" SuggestedHeight="980"
				                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
				                                                  Sprite="CharacterDeveloper\AttributePopup\attribute_popup_canvas">
					<Children>

						<ScrollablePanel Id="ScrollablePanel" WidthSizePolicy="CoverChildren"
						                 HeightSizePolicy="StretchToParent" MarginTop="10" AutoHideScrollBars="true"
						                 ClipRect="ClipRect" InnerPanel="ClipRect\InnerPanel"
						                 VerticalScrollbar="..\VerticalScrollbar">
							<Children>

								<Widget Id="ClipRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
								        ClipContents="true">
									<Children>

										<ListPanel Id="InnerPanel" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="820"
										           StackLayout.LayoutMethod="VerticalBottomToTop" DoNotAcceptEvents="true" MarginTop="20"
										           MarginBottom="60">
											<Children>

												<TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
												            HorizontalAlignment="Center" Brush="Encyclopedia.SubPage.Header.Text"
												            Text="@EstatesText" MarginBottom="8" />

												<GridWidget DataSource="{EstatesList}" WidthSizePolicy="StretchToParent"
												            HeightSizePolicy="CoverChildren" MarginRight="20" MarginLeft="20" HorizontalAlignment="Center"
												            DefaultCellWidth="780" DefaultCellHeight="780" ColumnCount="1" MarginTop="10">
													<ItemTemplate>
														<Widget HorizontalAlignment="Center" HeightSizePolicy="CoverChildren"
														        WidthSizePolicy="StretchToParent" VerticalAlignment="Center">
															<Children>

																<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="7"
																        MarginLeft="120" MarginRight="120" VerticalAlignment="Top" PositionYOffset="7"
																        Sprite="SPGeneral\TownManagement\horizontal_divider" />

																<ListPanel HorizontalAlignment="Center" HeightSizePolicy="CoverChildren" WidthSizePolicy="StretchToParent"
																           MarginTop="40" MarginBottom="40" StackLayout.LayoutMethod="VerticalBottomToTop">
																	<Children>

																		<RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
																		                HorizontalAlignment="Center" Brush="Clan.Leader.Text" Brush.FontSize="25" Text="@NameText" />

																		<!-- Top section: portrait + main info stats -->
																		<ListPanel HorizontalAlignment="Center" HeightSizePolicy="CoverChildren" WidthSizePolicy="StretchToParent"
																		           MarginTop="20" StackLayout.LayoutMethod="HorizontalLeftToRight">
																			<Children>

																				<Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="200" SuggestedHeight="160" IsVisible="@IsEnabled">
																					<Children>
																						<ImageIdentifierWidget DataSource="{ImageIdentifier}" WidthSizePolicy="Fixed" HorizontalAlignment="Center"
																						                       HeightSizePolicy="Fixed" SuggestedWidth="170" SuggestedHeight="130"
																						                       MarginRight="18" MarginTop="17" MarginBottom="18" AdditionalArgs="@AdditionalArgs"
																						                       ImageId="@Id" TextureProviderName="@TextureProviderName" />
																					</Children>
																				</Widget>

																				<ListPanel DataSource="{MainInfo}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
																				           VerticalAlignment="Top" StackLayout.LayoutMethod="VerticalBottomToTop">
																					<ItemTemplate>
																						<Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren">
																							<Children>
																								<HintWidget DataSource="{Hint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
																								            HorizontalAlignment="Left" MarginLeft="8"
																								            Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" IsEnabled="false">
																									<Children>
																										<ListPanel DataSource="{..}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
																										           StackLayout.LayoutMethod="HorizontalLeftToRight" MinHeight="38">
																											<Children>
																												<TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
																												            Brush="TownManagement.Description.Title.Text" Brush.FontSize="20" Text="@Title" />
																												<TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" VerticalAlignment="Center"
																												            MarginLeft="5" Brush="TownManagement.Description.Value.Text" Brush.FontSize="20" IntText="@Value" />
																												<ChangeAmountTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" MaxWidth="80"
																												                        HorizontalAlignment="Center" VerticalAlignment="Center"
																												                        Brush="Settlement.Property.PositiveChange.Text" Amount="@ValueChange"
																												                        NegativeBrushName="TownManagement.Property.NegativeChange.Text"
																												                        PositiveBrushName="TownManagement.Property.PositiveChange.Text" UseParentheses="true" />
																												<DescriptionItemVisualBrushWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="30" SuggestedHeight="30"
																												                                  VerticalAlignment="Center" Brush="TownManamgement.Description.Type.Brush" Type="@Type" />
																											</Children>
																										</ListPanel>
																									</Children>
																								</HintWidget>
																							</Children>
																						</Widget>
																					</ItemTemplate>
																				</ListPanel>
																			</Children>
																		</ListPanel>

																		<!-- Spec dropdown — replaces the old Task selector. -->
																		<Standard.DropdownWithHorizontalControl Parameter.SelectorDataSource="{SpecSelector}"
																		                                        MarginTop="14" HorizontalAlignment="Center" IsVisible="@IsEnabled" />

																		<!-- Cap warning — only shown when Growth at saturation. -->
																		<RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
																		                HorizontalAlignment="Center" Brush="ClanFinance.NegativeChange" Brush.FontSize="18"
																		                Text="@CapWarning" IsVisible="@CapWarningVisible" MarginTop="6" />

																		<!-- Single vertical column for all stats sections.
																		     InformationElement is CoverChildren width so multi-column
																		     grids overflow into each other when text is long. Linear
																		     stacking is reliable: each section contributes a vertical
																		     run of rows; sections are visually separated by a thin
																		     divider widget below. -->
																		<ListPanel DataSource="{ExtraInfos}" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren"
																		           HorizontalAlignment="Center" SuggestedWidth="700"
																		           StackLayout.LayoutMethod="VerticalBottomToTop" MarginTop="14"
																		           IsVisible="@IsEnabled">
																			<ItemTemplate>
																				<ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
																				           HorizontalAlignment="Center"
																				           StackLayout.LayoutMethod="VerticalBottomToTop" MarginTop="6" MarginBottom="10">
																					<ItemTemplate>
																						<InformationElement MarginBottom="2" />
																					</ItemTemplate>
																				</ListPanel>
																			</ItemTemplate>
																		</ListPanel>

																		<!-- Action buttons in a single horizontal row.
																		     Five at 150 wide × 12 margin = 750+96 < 820 card width. -->
																		<ListPanel HorizontalAlignment="Center" HeightSizePolicy="CoverChildren" WidthSizePolicy="CoverChildren"
																		           StackLayout.LayoutMethod="HorizontalLeftToRight" VerticalAlignment="Center"
																		           MarginTop="16" MarginBottom="60">
																			<Children>
																				<ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedHeight="60"
																				              SuggestedWidth="150" MarginRight="8" MarginLeft="8" Brush="ButtonBrush2"
																				              Command.Click="ExecuteBuy" IsVisible="@BuyVisible">
																					<Children>
																						<RichTextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
																						                HeightSizePolicy="StretchToParent" HorizontalAlignment="Center"
																						                VerticalAlignment="Center" Brush="OverlayPopup.ButtonText"
																						                Brush.FontSize="22" Text="@BuyText" />
																					</Children>
																				</ButtonWidget>
																				<ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedHeight="60"
																				              SuggestedWidth="150" MarginRight="8" MarginLeft="8" Brush="ButtonBrush2"
																				              Command.Click="ExecuteRetinue" IsVisible="@GrantVisible">
																					<Children>
																						<RichTextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
																						                HeightSizePolicy="StretchToParent" HorizontalAlignment="Center"
																						                VerticalAlignment="Center" Brush="OverlayPopup.ButtonText"
																						                Brush.FontSize="22" Text="@RetinueText" />
																					</Children>
																				</ButtonWidget>
																				<ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedHeight="60"
																				              SuggestedWidth="150" MarginRight="8" MarginLeft="8" Brush="ButtonBrush2"
																				              Command.Click="ExecuteSlaves" IsVisible="@GrantVisible">
																					<Children>
																						<RichTextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
																						                HeightSizePolicy="StretchToParent" HorizontalAlignment="Center"
																						                VerticalAlignment="Center" Brush="OverlayPopup.ButtonText"
																						                Brush.FontSize="22" Text="@SlavesText" />
																					</Children>
																				</ButtonWidget>
																				<ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedHeight="60"
																				              SuggestedWidth="150" MarginRight="8" MarginLeft="8" Brush="ButtonBrush2"
																				              Command.Click="ExecuteGrant" IsVisible="@GrantVisible">
																					<Children>
																						<RichTextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
																						                HeightSizePolicy="StretchToParent" HorizontalAlignment="Center"
																						                VerticalAlignment="Center" Brush="OverlayPopup.ButtonText"
																						                Brush.FontSize="22" Text="@GrantText" />
																					</Children>
																				</ButtonWidget>
																				<ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedHeight="60"
																				              SuggestedWidth="150" MarginRight="8" MarginLeft="8" Brush="ButtonBrush2"
																				              Command.Click="ExecuteReclaim" IsVisible="@ReclaimVisible">
																					<Children>
																						<RichTextWidget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent"
																						                HeightSizePolicy="StretchToParent" HorizontalAlignment="Center"
																						                VerticalAlignment="Center" Brush="OverlayPopup.ButtonText"
																						                Brush.FontSize="22" Text="@ReclaimText" />
																					</Children>
																				</ButtonWidget>
																			</Children>
																		</ListPanel>
																	</Children>
																</ListPanel>
															</Children>
														</Widget>
													</ItemTemplate>
												</GridWidget>
											</Children>
										</ListPanel>
									</Children>
								</Widget>

								<!--Scroll Gradient-->
								<Widget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
								        SuggestedHeight="57" HorizontalAlignment="Right" VerticalAlignment="Bottom"
								        Sprite="General\CharacterCreation\character_creation_scroll_gradient" />

							</Children>
						</ScrollablePanel>

						<ScrollbarWidget HeightSizePolicy="StretchToParent" WidthSizePolicy="Fixed" Id="VerticalScrollbar"
						                 SuggestedWidth="30" MinValue="0" MaxValue="100" MarginRight="10" MarginBottom="10"
						                 MarginTop="10" AlignmentAxis="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center"
						                 Handle="ScrollbarHandle" UpdateChildrenStates="true">
							<Children>
								<Widget Id="ScrollbarBed" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="4"
								        HorizontalAlignment="Center" Sprite="SPGeneral\SPRecruitment\slider_thin_bed_vertical" />
								<ImageWidget Id="ScrollbarHandle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" MinHeight="153"
								             SuggestedWidth="30" SuggestedHeight="150" HorizontalAlignment="Center"
								             Brush="Encyclopedia.Scroll.Handle.Vertical" />
							</Children>
						</ScrollbarWidget>


						<Widget DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
						        ExtendLeft="25" ExtendTop="25" ExtendRight="25" ExtendBottom="25"
						        Sprite="CharacterDeveloper\AttributePopup\attribute_popup_frame" />

						<!--Close Inspection Popup Button-->
						<ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
						              SuggestedWidth="84" SuggestedHeight="84" HorizontalAlignment="Center" VerticalAlignment="Center"
						              MarginLeft="850" MarginBottom="980" Command.Click="ExecuteClose" Brush="Attribute.Close.Button" />

					</Children>
				</CharacterDeveloperAttributeInspectionPopupWidget>


			</Children>
		</Widget>
	</Window>
</Prefab>
