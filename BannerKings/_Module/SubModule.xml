<?xml version="1.0" encoding="UTF-8"?>

<Module xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/BUTR/Bannerlord.XmlSchemas/master/SubModule.xsd">
	<Id value="BannerKings.Redux" />
	<Name value="Banner Kings — Redux" />
	<Version value="v1.9.33.6" />
	<Official value="false" />
	<DefaultModule value="true" />
	<ModuleCategory value="Singleplayer" />
	<DependedModules>
		<DependedModule Id="Bannerlord.Harmony" />
		<DependedModule Id="Bannerlord.ButterLib" />
		<DependedModule Id="Bannerlord.UIExtenderEx" />
		<DependedModule Id="Bannerlord.MBOptionScreen" />
		<DependedModule Id="Native" />
		<DependedModule Id="SandBoxCore" />
		<DependedModule Id="Sandbox" />
		<DependedModule Id="StoryMode" />
		<DependedModule Id="CustomBattle" />
	</DependedModules>
	<!-- Community Dependency Metadata -->
	<DependedModuleMetadatas>
		<DependedModuleMetadata id="Bannerlord.Harmony" order="LoadBeforeThis" />
		<DependedModuleMetadata id="Bannerlord.ButterLib" order="LoadBeforeThis" />
		<DependedModuleMetadata id="Bannerlord.UIExtenderEx" order="LoadBeforeThis" />
		<DependedModuleMetadata id="Bannerlord.MBOptionScreen" order="LoadBeforeThis" />
		<DependedModuleMetadata id="Native" order="LoadBeforeThis" />
		<DependedModuleMetadata id="SandBoxCore" order="LoadBeforeThis" />
		<DependedModuleMetadata id="Sandbox" order="LoadBeforeThis" />
		<DependedModuleMetadata id="StoryMode" order="LoadBeforeThis" />
		<DependedModuleMetadata id="CustomBattle" order="LoadBeforeThis" />
		<!-- Bannerlord Living Economy: load-before BK so BK's Harmony patches
		     resolve against its assembly when present. -->
		<DependedModuleMetadata id="BetterEconomy" order="LoadBeforeThis" optional="true" />
		<!-- Optional cooperator mods: load BK before, then yield to them at runtime
		     via BannerKings.Utils.ModCompat. Listed here so the launcher orders them
		     correctly when both are installed. -->
		<DependedModuleMetadata id="Diplomacy" order="LoadAfterThis" optional="true" />
		<!-- ImprovedGarrisons metadata retired in v1.9.9.3 — IG was not
		     compatible in practice; BK now overrides the garrison model
		     unconditionally rather than yielding. -->
		<DependedModuleMetadata id="RecruitEverywhere" order="LoadAfterThis" optional="true" />
		<DependedModuleMetadata id="MarryAnyone" order="LoadAfterThis" optional="true" />
		<DependedModuleMetadata id="BuyLandAtVillages" order="LoadAfterThis" optional="true" />
		<!-- RBM v4.2.x renamed its module from "RBMCombat" (pre-v4) to "RBM";
		     declared both so the launcher orders BK after either install. RBM_WS
		     is the NavalDLC submod, also load-after. The RTS Camera pair are
		     Mission-scope but BK has a few Mission-scope hooks (NavalPerkPatches,
		     BKTournamentBehavior); load-after keeps the Harmony stack stable. -->
		<DependedModuleMetadata id="RBMCombat" order="LoadAfterThis" optional="true" />
		<DependedModuleMetadata id="RBM" order="LoadAfterThis" optional="true" />
		<DependedModuleMetadata id="RBM_WS" order="LoadAfterThis" optional="true" />
		<DependedModuleMetadata id="RTSCamera" order="LoadAfterThis" optional="true" />
		<DependedModuleMetadata id="RTSCamera.CommandSystem" order="LoadAfterThis" optional="true" />
		<DependedModuleMetadata id="AIInfluence" order="LoadAfterThis" optional="true" />
		<DependedModuleMetadata id="realmofthrones.core" order="LoadAfterThis" optional="true" />
		<!-- Shokuho is a total conversion with its own ShokuhoCampaign GameType.
		     BK's behaviors register for Campaign / CampaignStoryMode so they do
		     not auto-load into a Shokuho save; LoadAfterThis is declared so the
		     ModCompat.Shokuho probe sees the module list at BK init time. -->
		<DependedModuleMetadata id="Shokuho" order="LoadAfterThis" optional="true" />
		<!-- Adonnay's Troop Changer + De Re Militari: load BEFORE BK (unlike the
		     cooperators above). ATC registers its own VolunteerModel and patches
		     the recruit hook; BK must register its VolunteerModel AFTER ATC so BK
		     keeps owning recruitment policy (demesne-law recruit caps, manpower
		     gating, draft efficiency) while ATC owns the troop rosters. Loading ATC
		     first also guarantees its assembly is present when BK reflectively
		     patches ATCConfig.NotableShouldGiveEliteTroop (see AtcBridge). DeReMilitari
		     is data-only (troop trees / items / cultures) and load-before so its
		     XML/XSLT edits apply before BK reads culture troop objects. -->
		<DependedModuleMetadata id="AdonnaysTroopChanger" order="LoadBeforeThis" optional="true" />
		<DependedModuleMetadata id="DeReMilitari" order="LoadBeforeThis" optional="true" />
	</DependedModuleMetadatas>
	<!-- Community Dependency Metadata -->
	<SubModules>
		<SubModule>
			<Name value="BannerKings" />
			<DLLName value="BannerKings.dll" />
			<SubModuleClassType value="BannerKings.Main" />
			<Tags />
		</SubModule>
	</SubModules>
	<Xmls>
		<XmlNode>
			<XmlName id="GameText" path="gt_common" />
			<IncludedGameTypes>
				<GameType value = "Campaign"/>
				<GameType value = "CampaignStoryMode"/>
			</IncludedGameTypes>
		</XmlNode>
		<XmlNode>
			<XmlName id="EquipmentRosters" path="equipment_sets" />
			<IncludedGameTypes>
				<GameType value="Campaign" />
				<GameType value="CampaignStoryMode" />
			</IncludedGameTypes>
		</XmlNode>
		<XmlNode>
			<XmlName id="NPCCharacters" path="Characters" />
			<IncludedGameTypes>
				<GameType value="Campaign" />
				<GameType value="CampaignStoryMode" />
			</IncludedGameTypes>
		</XmlNode>
		<XmlNode>
			<XmlName id="partyTemplates" path="partyTemplates" />
			<IncludedGameTypes>
				<GameType value="Campaign" />
				<GameType value="CampaignStoryMode" />
			</IncludedGameTypes>
		</XmlNode>
		<XmlNode>                
			<XmlName id="WorkshopTypes" path="workshops"/>
			<IncludedGameTypes>
				<GameType value = "Campaign"/>
				<GameType value = "CampaignStoryMode"/>
			</IncludedGameTypes>
		</XmlNode> 
		<XmlNode>                
			<XmlName id="Concepts" path="concept_strings"/>
			<IncludedGameTypes>
				<GameType value = "Campaign"/>
				<GameType value = "CampaignStoryMode"/>
			</IncludedGameTypes>
		</XmlNode>   
		<XmlNode>
			<XmlName id="ItemModifiers" path="item_modifiers" />
		</XmlNode>
		<XmlNode>
			<XmlName id="ItemModifierGroups" path="item_modifiers_groups" />
		</XmlNode>
		<XmlNode>
			<XmlName id="Items" path="items"/>
			<IncludedGameTypes>
				<GameType value="Campaign"/>
				<GameType value="CampaignStoryMode"/>
				<GameType value="CustomGame"/>
				<GameType value="EditorGame"/>
			</IncludedGameTypes>
		</XmlNode>
	</Xmls>
</Module>