<?xml version="1.0" encoding="utf-8"?>
<!--
  BK structural data — Council Positions. "Refs-only" conversion: the
  structural refs (governing skills, council tasks, privileges, trait weights,
  ai-priority flag) live here; the behaviour (adequacy / candidate-validity
  predicates AND the per-culture title map) is C# resolved by the behavior key
  against BannerKings.Utils.BKData.CouncilPositionRegistry.

  Schema:
    <council_position id="..."
                      behavior="<registry_key>"
                      primary_skill="<skill_id>"
                      secondary_skill="<skill_id>"     optional (omit for none)
                      ai_priority="true|false">
      <tasks>      <task ref="<council_task_id>"/> ...      </tasks>
      <privileges> <privilege id="ARMY_PRIVILEGE"/> ...     </privileges>
      <trait_weights> <trait ref="<trait_id>" weight="N"/> ... </trait_weights>
    </council_position>

  Skill refs resolve against every registered SkillObject (vanilla + BK).
  task refs resolve against DefaultCouncilTasks (the loader takes a GetCopy()).
  privilege ids are the CouncilPrivileges enum. trait refs resolve against
  every TraitObject. A council position carries no name in XML — its name is
  produced at runtime by the behavior's per-culture CulturalName resolver.
-->
<council_positions>
  <council_position id="LegionCommander1" behavior="LegionCommander" primary_skill="Leadership" secondary_skill="Tactics" ai_priority="true">
    <tasks><task ref="GatherLegion"/></tasks>
    <privileges>
      <privilege id="ARMY_PRIVILEGE"/>
      <privilege id="NOBLE_EXCLUSIVE"/>
    </privileges>
    <trait_weights>
      <trait ref="Valor" weight="0.05"/>
      <trait ref="Calculating" weight="0.05"/>
    </trait_weights>
  </council_position>

