<?xml version="1.0" encoding="utf-8"?>
<!--
  BK structural data — Faiths.
  Schema:
    <faith id="..." flavor="Monotheistic|Polytheistic|Henotheistic|Dualistic"
           main_god="<divinity_id>"
           group="<faith_group_id>"
           marriage_doctrine="<marriage_doctrine_id>"
           war_doctrine="<war_doctrine_id>"
           banner_code="..."           optional
           faith_seat="<settlement_id>" optional>
      <name>...</name>
      <description>...</description>
      <cults_desc>imperial cults</cults_desc>
      <zealots_name>Sons of Darusos</zealots_name>
      <blessing_action>...</blessing_action>
      <blessing_action_name>...</blessing_action_name>
      <blessing_question>...</blessing_question>
      <blessing_confirm_question>...</blessing_confirm_question>
      <natural_cultures>           variable size
        <culture id="empire"/>
      </natural_cultures>
      <pantheon>                   variable size — minor divinities only;
        <divinity ref="astaronia"/> main_god is the attribute above
        <divinity ref="darusos"/>
      </pantheon>
      <doctrines>                  variable size
        <doctrine ref="Legalism"/>
        ...
      </doctrines>
      <ranks>                      variable size — N <rank/> = N clergy ranks
        <rank>Acolyte</rank>        the text becomes bk_faith_<id>_rank_<n>
        <rank>Lictor</rank>
        <rank>Pontifex</rank>
      </ranks>
      <rites>                      variable size — keys resolve via RiteRegistry
        <rite key="astaronia_festival"/>
        ...
      </rites>
    </faith>
  Adding a new faith: pick a unique id, fill every text field, list any number
  of cultures / divinities / doctrines / ranks / rites. A faith with no rites
  or no minor pantheon is legal (Asera ships with no rites and no minor
  divinities). Faiths whose culture refs don't resolve at init time are
  silently dropped from DefaultReligions, same as the hardcoded behaviour.
-->
<faiths>
  <faith id="darusosian"
         flavor="Henotheistic"
         main_god="iovis"
         group="imperial_orders"
         marriage_doctrine="Monogamy"
         war_doctrine="OpenWarfare">
    <name>Darusosian Path</name>
    <description>The Darusosian Path is the imperial faith of the Calradian Empire — the cult of Iovis the Sky-Father, his bride Astaronia, and the iron-saint Darusos. Its priests serve the legions and the law, and its rites uphold the unity of the Empire under one heaven.</description>
    <cults_desc>imperial cults</cults_desc>
    <zealots_name>Sons of Darusos</zealots_name>
    <blessing_action>I would seek a blessing of the Triad.</blessing_action>
    <blessing_action_name>imperial blessings</blessing_action_name>
    <blessing_question>Which of the Triad shall hear your prayer?</blessing_question>
    <blessing_confirm_question>Will you commit your devotion to {DIVINITY}?</blessing_confirm_question>
    <natural_cultures>
      <culture id="empire"/>
    </natural_cultures>
    <pantheon>
      <divinity ref="astaronia"/>
      <divinity ref="darusos"/>
    </pantheon>
    <doctrines>
      <doctrine ref="legalism"/>
      <doctrine ref="RenovatioImperi"/>
      <doctrine ref="Tolerant"/>
      <doctrine ref="Astrology"/>
      <doctrine ref="Esotericism"/>
    </doctrines>
    <ranks>
      <rank>Acolyte</rank>
      <rank>Lictor</rank>
      <rank>Pontifex</rank>
    </ranks>
    <rites>
      <rite key="astaronia_festival"/>
      <rite key="darusosian_homage"/>
      <rite key="darusosian_execution"/>
    </rites>
  </faith>

  <faith id="canticles"
