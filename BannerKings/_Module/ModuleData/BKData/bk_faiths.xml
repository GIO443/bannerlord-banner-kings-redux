         main_god="caion"
         group="vlandic_canonical"
         marriage_doctrine="Monogamy"
         war_doctrine="OpenWarfare">
    <name>Canticles of Caïon</name>
    <description>The Canticles are the sworn faith of Vlandia: a chivalric devotion to Caïon, crowner of kings, and his retinue of warrior-saints. Its priests bless oaths, marriages and lances; its great hymnals are sung at every coronation.</description>
    <cults_desc>canticle saints</cults_desc>
    <zealots_name>Order of the Lance</zealots_name>
    <blessing_action>Father, would you sing a canticle for me?</blessing_action>
    <blessing_action_name>canticle blessings</blessing_action_name>
    <blessing_question>Which saint will you ask to sing for?</blessing_question>
    <blessing_confirm_question>Will you commit yourself to the saint's road?</blessing_confirm_question>
    <natural_cultures>
      <culture id="vlandia"/>
    </natural_cultures>
    <pantheon>
      <divinity ref="marcosus"/>
      <divinity ref="belisaria"/>
      <divinity ref="reginus"/>
    </pantheon>
    <doctrines>
      <doctrine ref="legalism"/>
      <doctrine ref="childbirth"/>
      <doctrine ref="Warlike"/>
      <doctrine ref="literalism"/>
    </doctrines>
    <ranks>
      <rank>Brother</rank>
      <rank>Canon</rank>
      <rank>Primarch</rank>
    </ranks>
    <rites>
      <rite key="lance_offering"/>
      <rite key="vlandia_horse"/>
    </rites>
  </faith>

  <faith id="amra"
         flavor="Polytheistic"
         main_god="perkos"
         group="druidic_circles"
         marriage_doctrine="Concubinage"
         war_doctrine="NoWarfare">
    <name>Amra Druidh</name>
    <description>The druidic faith of the Battanian highlands. Pérkos the Thunder-Wielder rules the canopy, but Máthair, Iarnan and Eilean walk every glen and lynn. The druids carry the songs and bind the spirits to the deeds of clans.</description>
    <cults_desc>druidic spirits</cults_desc>
    <zealots_name>Fian Wardancers</zealots_name>
    <blessing_action>I would seek a druid's blessing.</blessing_action>
    <blessing_action_name>druidic blessings</blessing_action_name>
    <blessing_question>Whose blessing do you carry from the lynn?</blessing_question>
    <blessing_confirm_question>Will you carry their mark?</blessing_confirm_question>
    <natural_cultures>
      <culture id="battania"/>
    </natural_cultures>
    <pantheon>
      <divinity ref="mathair"/>
      <divinity ref="iarnan"/>
      <divinity ref="eilean"/>
    </pantheon>
    <doctrines>
      <doctrine ref="druidism"/>
