<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Version>1.9.2</Version>
		<TargetFramework>net48</TargetFramework>
		<Platforms>x64</Platforms>
		<LangVersion>9.0</LangVersion>
		<Nullable>disable</Nullable>
		<ModuleId>BannerKings.Redux</ModuleId>
		<ModuleName>BannerKings.Redux</ModuleName>
		<GameFolder>$(BANNERLORD_GAME_DIR)</GameFolder>
		<OutputPath>C:\Program Files (x86)\Steam\steamapps\common\Mount &amp; Blade II Bannerlord\Modules\BannerKings.Redux\bin\Win64_Shipping_Client</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
		<DebugType>portable</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
		<DebugType>portable</DebugType>
	</PropertyGroup>

	<!-- Local dev: resolve game DLLs from the installed game directory. -->
	<ItemGroup Condition="'$(BANNERLORD_GAME_DIR)' != ''">
		<Reference Include="$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.*.dll" Exclude="$(GameFolder)\bin\Win64_Shipping_Client\TaleWorlds.Native.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="$(GameFolder)\Modules\Native\bin\Win64_Shipping_Client\*.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="$(GameFolder)\Modules\SandBox\bin\Win64_Shipping_Client\*.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="$(GameFolder)\Modules\SandBoxCore\bin\Win64_Shipping_Client\*.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="$(GameFolder)\Modules\StoryMode\bin\Win64_Shipping_Client\*.dll">
			<HintPath>%(Identity)</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<!-- CI / no-game-install: pull stripped reference DLLs from BUTR's NuGet
	     packages. Pinned to game build v1.4.5 (114896) — the project targets
	     the 1.4 API surface, so these MUST track 1.4.x; 1.3.x reference
	     assemblies miss the 1.4-renamed members (CanLordCreateArmy,
	     GetPartySpottingRatioForMainPartySeeingRange, the split patrolling
	     score model) and fail the CI build. Sub-packages listed individually
	     instead of via the umbrella package — when included via the umbrella,
	     MSBuild's reference resolver only surfaced the Core DLLs and the
	     SandBox/StoryMode/Native types went missing. -->
	<ItemGroup Condition="'$(BANNERLORD_GAME_DIR)' == ''">
		<PackageReference Include="Bannerlord.ReferenceAssemblies.Core" Version="1.4.5.114896" IncludeAssets="compile" PrivateAssets="all" />
		<PackageReference Include="Bannerlord.ReferenceAssemblies.Native" Version="1.4.5.114896" IncludeAssets="compile" PrivateAssets="all" />
		<PackageReference Include="Bannerlord.ReferenceAssemblies.SandBox" Version="1.4.5.114896" IncludeAssets="compile" PrivateAssets="all" />
		<PackageReference Include="Bannerlord.ReferenceAssemblies.StoryMode" Version="1.4.5.114896" IncludeAssets="compile" PrivateAssets="all" />
		<PackageReference Include="Bannerlord.ReferenceAssemblies.CustomBattle" Version="1.4.5.114896" IncludeAssets="compile" PrivateAssets="all" />
		<PackageReference Include="Bannerlord.ReferenceAssemblies.BirthAndDeath" Version="1.4.5.114896" IncludeAssets="compile" PrivateAssets="all" />
		<PackageReference Include="Bannerlord.ReferenceAssemblies.NavalDLC" Version="1.4.5.114896" IncludeAssets="compile" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- MCMv5 — same strict-version story as ButterLib + UIExtenderEx
		     below. v5.5.5 NuGet stamps AssemblyVersion=5.5.5.0, which v1.9.1.6
		     BK.dll references. Current ecosystem ships MCMv5 5.11.x; the user's
		     crash report module list confirmed MCMv5 v5.11.4.0 installed.
		     Without this bump, CLR refuses to bind v5.5.5.0 against the
		     installed v5.11.4.0 — ReflectionTypeLoadException at OnSubModuleLoad,
		     same shape as the UIExtenderEx issue v1.9.1.6 fixed. -->
		<PackageReference Include="Bannerlord.MCM" Version="5.11.4">
		  <IncludeAssets>compile</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Nullable" Version="1.3.1" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
		<PackageReference Include="IsExternalInit" Version="1.0.3" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
		<PackageReference Include="Bannerlord.BuildResources" Version="1.0.1.92" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
		<PackageReference Include="Lib.Harmony" Version="2.2.2" IncludeAssets="compile" />
		<PackageReference Include="Harmony.Extensions" Version="3.2.0.75" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
		<PackageReference Include="BUTR.Harmony.Analyzer" Version="1.0.1.44" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
		<!-- ButterLib + UIExtenderEx are the two community framework deps.
		     BK was previously pinned to ButterLib 2.6.3 and UIExtenderEx 2.6.0
		     (1.3.x-era). The current 1.4 ecosystem ships ButterLib 2.10.x and
		     UIExtenderEx 2.13.x. CLR strict-version binding refused to load
		     BK.dll because its assembly metadata referenced the old versions
		     and the runtime only had the new ones installed — crash.htm 22:15
		     showed ReflectionTypeLoadException "Could not load file or
		     assembly 'Bannerlord.UIExtenderEx, Version=2.6.0.0'" at OnSubModuleLoad.
		     Bumped both to match what users actually have installed (the user's
		     own crash report module list reported ButterLib 2.10.4.0 and
		     UIExtenderEx 2.13.2.0). IncludeAssets=compile so the packages
		     aren't packed into the release zip; we only need the reference. -->
		<PackageReference Include="Bannerlord.ButterLib" Version="2.10.4" IncludeAssets="compile" />
		<PackageReference Include="Bannerlord.UIExtenderEx" Version="2.13.2" IncludeAssets="compile" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.2" PrivateAssets="all" IncludeAssets="compile" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Patches\" />
	</ItemGroup>

	<!-- Bannerlord Living Economy (BetterEconomy) — hard dependency. BK
	     force-enables and reads its feudal-economy layer (social classes,
	     estates, demand). Dual-path resolution, mirroring the game DLLs above:
	     local dev resolves it from the installed BetterEconomy module; CI
	     (clean checkout, no game install) resolves it from the build-only
	     reference copy under externals/. Private=false on both — it is a
	     compile reference only, never copied into the BannerKings module
	     output and never present in the release zip. -->
	<ItemGroup Condition="'$(BANNERLORD_GAME_DIR)' != ''">
		<Reference Include="BetterEconomy">
			<HintPath>$(GameFolder)\Modules\BetterEconomy\bin\Win64_Shipping_Client\BetterEconomy.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>
	<ItemGroup Condition="'$(BANNERLORD_GAME_DIR)' == ''">
		<Reference Include="BetterEconomy">
			<HintPath>externals\BetterEconomy.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<PropertyGroup>
		<ModuleRoot>$([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName($(OutputPath)))))</ModuleRoot>
	</PropertyGroup>

	<Target Name="DeployModuleAssets" AfterTargets="Build" Condition="'$(SkipModuleDeploy)' != 'true'">
		<ItemGroup>
			<ModuleAssets Include="$(MSBuildProjectDirectory)\_Module\**\*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(ModuleAssets)"
		      DestinationFiles="@(ModuleAssets->'$(ModuleRoot)\%(RecursiveDir)%(Filename)%(Extension)')"
		      SkipUnchangedFiles="true" />
	</Target>

	<!-- Bannerlord.BuildResources auto-deploys to Modules/$(MSBuildProjectName)/...
	     which is "Modules/BannerKings/" (the legacy folder), not our renamed
	     "BannerKings.Redux" module. Force-copy the build output to the Redux
	     module folder so the renamed module actually receives a DLL. -->
	<Target Name="DeployReduxBin" AfterTargets="Build" Condition="'$(SkipModuleDeploy)' != 'true'">
		<ItemGroup>
			<ReduxBin Include="$(MSBuildProjectDirectory)\obj\$(Configuration)\BannerKings.dll" />
			<ReduxBin Include="$(MSBuildProjectDirectory)\obj\$(Configuration)\BannerKings.pdb" />
		</ItemGroup>
		<Copy SourceFiles="@(ReduxBin)"
		      DestinationFolder="$(ModuleRoot)\bin\Win64_Shipping_Client"
		      SkipUnchangedFiles="true"
		      Condition="Exists('%(Identity)')" />
	</Target>

</Project>